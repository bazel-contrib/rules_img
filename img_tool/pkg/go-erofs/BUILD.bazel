# Tests of the internals of the compression code: the LZ4 encoder and the
# compressed-index writer, which they check against reference decoders.
go_test(
    name = "go-erofs_internal_test",
    srcs = ["zfile_test.go"],
    embed = [":go-erofs"],
)
