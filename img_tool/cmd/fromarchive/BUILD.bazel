load("@rules_go//go:def.bzl", "go_library", "go_test")

# Keep the go_test target name short so its runfiles path stays well under
# Windows MAX_PATH (260 characters), where both package and target name appear twice.
# gazelle:exclude archive_test.go

go_library(
    name = "fromarchive",
    srcs = ["fromarchive.go"],
    importpath = "github.com/bazel-contrib/rules_img/img_tool/cmd/fromarchive",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/imagearchive",
        "@com_github_opencontainers_image_spec//specs-go/v1:specs-go",
    ],
)

go_test(
    name = "archive_test",
    size = "small",
    # keep
    srcs = ["archive_test.go"],
    embed = [":fromarchive"],
    # keep
    deps = [
        "//pkg/api",
        "//pkg/imagearchive",
        "//pkg/imagearchive/archivetest",
        "@com_github_google_go_containerregistry//pkg/name",
        "@com_github_google_go_containerregistry//pkg/v1:pkg",
        "@com_github_google_go_containerregistry//pkg/v1/empty",
        "@com_github_google_go_containerregistry//pkg/v1/layout",
        "@com_github_google_go_containerregistry//pkg/v1/mutate",
        "@com_github_google_go_containerregistry//pkg/v1/tarball",
        "@com_github_google_go_containerregistry//pkg/v1/types",
        "@com_github_opencontainers_image_spec//specs-go/v1:specs-go",
    ],
)
