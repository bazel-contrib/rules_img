load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dd",
    srcs = [
        "dd.go",
        "progress.go",
        "run.go",
        "sink.go",
        "source.go",
    ],
    importpath = "github.com/bazel-contrib/rules_img/img_tool/cmd/dd",
    visibility = ["//visibility:public"],
    deps = [
        "//cmd/deploy",
        "//pkg/bytesize",
        "//pkg/compactstream",
        "//pkg/deployvfs",
        "//pkg/extentstream",
