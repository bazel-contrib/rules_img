go_test(
    name = "dd_test",
    size = "small",
    srcs = ["dd_test.go"],
    embed = [":dd"],
    deps = [
        "//pkg/casdirlayout",
        "//pkg/compactstream",
        "//pkg/extentstream",
    ],
)
