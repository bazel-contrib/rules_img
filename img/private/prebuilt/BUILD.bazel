load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//img/private/prebuilt:lockfile_test.bzl", "lockfile_test_suite")

lockfile_test_suite(name = "lockfile_test")

bzl_library(
    name = "prebuilt",
    srcs = ["prebuilt.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":lockfile",
        "//img/private/platforms",
    ],
)

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
    visibility = ["//img/private/release:__subpackages__"],
)

bzl_library(
    name = "lockfile",
    srcs = ["lockfile.bzl"],
    visibility = ["//img:__subpackages__"],
)
