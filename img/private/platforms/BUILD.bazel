load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":match_test.bzl", "match_test_suite")
load(":matching_test.bzl", "matching_test_suite")
load(":platforms.bzl", "PLATFORMS")
load(":selection_test.bzl", "selection_test_suite")

package(
    default_visibility = ["//visibility:public"],
)

matching_test_suite(name = "matching_test")

match_test_suite(name = "match_test")

selection_test_suite(name = "selection_test")

[
    platform(
        name = name,
        constraint_values = info.constraints,
    )
    for name, info in PLATFORMS.items()
]

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
    visibility = ["//img/private/release:__subpackages__"],
)

bzl_library(
    name = "constraints",
    srcs = ["constraints.bzl"],
)

bzl_library(
    name = "matching",
    srcs = ["matching.bzl"],
    deps = ["//img/private:manifest_media_type"],
)

bzl_library(
    name = "platforms",
    srcs = ["platforms.bzl"],
)

bzl_library(
    name = "tables",
    srcs = ["tables.bzl"],
)

bzl_library(
    name = "match",
    srcs = ["match.bzl"],
)

bzl_library(
    name = "selection",
    srcs = ["selection.bzl"],
    deps = [
        ":match",
        ":tables",
    ],
)
