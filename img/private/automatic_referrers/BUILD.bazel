load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":automatic_referrers_test.bzl", "fake_automatic_referrers_toolchain")
load(":automatic_referrers_test_suite.bzl", "automatic_referrers_test_suite")

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
    visibility = ["//img/private/release:__subpackages__"],
)

bzl_library(
    name = "automatic_referrers",
    srcs = [
        "aspects.bzl",
        "automatic_referrers.bzl",
    ],
    visibility = ["//img:__subpackages__"],
    deps = [
        "//img/private:stamp",
        "//img/private/common:build",
        "//img/private/common:layer_helper",
        "//img/private/common:sparse_oci_layout",
        "//img/private/providers:automatic_referrers_info",
        "//img/private/providers:index_info",
        "//img/private/providers:layers_info",
        "//img/private/providers:manifest_info",
        "//img/private/providers:pull_info",
        "//img/private/providers:pulled_referrers_info",
        "//img/private/supply_chain_tools/gather_metadata",
        "@bazel_features//:features",
        "@package_metadata//:srcs",
    ],
)

fake_automatic_referrers_toolchain(name = "fake_toolchain_impl")

# Only registered by the tests that ask for it (via --extra_toolchains).
toolchain(
    name = "fake_toolchain",
    toolchain = ":fake_toolchain_impl",
    toolchain_type = "//img:automatic_referrers_toolchain_type",
)

fake_automatic_referrers_toolchain(
    name = "fake_scanning_toolchain_impl",
    scan = True,
)

toolchain(
    name = "fake_scanning_toolchain",
    toolchain = ":fake_scanning_toolchain_impl",
    toolchain_type = "//img:automatic_referrers_toolchain_type",
)

fake_automatic_referrers_toolchain(
    name = "fake_dropping_toolchain_impl",
    child_referrers = "drop",
)

toolchain(
    name = "fake_dropping_toolchain",
    toolchain = ":fake_dropping_toolchain_impl",
    toolchain_type = "//img:automatic_referrers_toolchain_type",
)

automatic_referrers_test_suite(name = "automatic_referrers_test")
