load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//img/private/platforms:tables.bzl", "CPU_CONSTRAINTS", "OS_CONSTRAINTS", "VARIANT_CONSTRAINTS")
load(":defs.bzl", "os_cpu")

# The same tables generate the config_settings of the routing repositories the images module
# extension creates, so a platform this rule can describe is a platform an image can be routed
# for, and vice versa.
os_cpu(
    name = "target_os_cpu",
    cpu = select(CPU_CONSTRAINTS),
    os = select(OS_CONSTRAINTS),
    variant = select(VARIANT_CONSTRAINTS),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
    visibility = ["//img/private/release:__subpackages__"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//img:__subpackages__"],
)
