# The test is written by hand: its arguments come from the image targets.
# gazelle:ignore

load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_go//go:def.bzl", "go_test")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "image_layer")
load("@rules_img//img:multi_deploy.bzl", "multi_deploy")
load("@rules_img//img:push.bzl", "image_push", "image_push_spec")

# A pulled image without the network: the fixture of a pull repository rule.
load("@rules_img//img/private:import.bzl", "image_import")  # buildifier: disable=bzl-visibility
load("//sbom:toolchain.bzl", "sbom_toolchain")
load(":fixture.bzl", "AMD64", "DATA", "INDEX", "SBOM", "files")
load(":toolchain_test.bzl", "drops_children_test", "rejects_dangling_references_test")

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

image_import(
    name = "base",
    data = DATA,
    digest = INDEX,
    files = files(":placeholder.json", ":base.cdx.json"),
    referrers = [SBOM],
    registries = ["registry.example.com"],
    repository = "example/base",
)

package_metadata(
    name = "hello_metadata",
    purl = "pkg:generic/hello@1.0.0",
)

genrule(
    name = "hello",
    outs = ["hello.txt"],
    cmd = "echo hello > $@",
)

image_layer(
    name = "layer",
    srcs = {"/hello.txt": ":hello"},
    package_metadata = [":hello_metadata"],
)

image_manifest(
    name = "image",
    base = ":base",
    layers = [":layer"],
    platform = ":linux_amd64",
)

image_manifest(
    name = "image_arm64",
    layers = [":layer"],
    platform = ":linux_arm64",
)

image_index(
    name = "index",
    manifests = [
        ":image",
        ":image_arm64",
    ],
)

filegroup(
    name = "image_sbom",
    srcs = [":image"],
    output_group = "sbom",
)

filegroup(
    name = "image_digest",
    srcs = [":image"],
    output_group = "digest",
)

filegroup(
    name = "index_sboms",
    srcs = [":index"],
    output_group = "sbom",
)

# Images that carry their pushes (push_specs), deployed by a multi_deploy: the
# SBOMs pushed to each destination name the image there.
image_push_spec(
    name = "ghcr",
    registry = "ghcr.io",
    # Expanded like the push's own repository.
    repository = "buildbarn/{{.image_target_name}}",
    tag = "latest",
)

image_push_spec(
    name = "mirror",
    registry = "registry.example.com",
    repository = "mirror/app",
    tag = "latest",
)

image_index(
    name = "pushed",
    manifests = [
        ":image",
        ":image_arm64",
    ],
    push_specs = [
        ":ghcr",
        ":mirror",
    ],
)

image_manifest(
    name = "pushed_manifest",
    layers = [":layer"],
    platform = ":linux_amd64",
    push_specs = [":ghcr"],
)

multi_deploy(
    name = "deploy",
    operations = [
        ":pushed",
        ":pushed_manifest",
    ],
)

# image_push names the image where it pushes it too.
image_push(
    name = "push",
    image = ":index",
    registry = "ghcr.io",
    repository = "buildbarn/index",
)

filegroup(
    name = "deploy_sboms",
    srcs = [
        ":pushed",
        ":pushed_manifest",
    ],
    output_group = "sbom",
)

filegroup(
    name = "push_sboms",
    srcs = [":push"],
    output_group = "sbom",
)

# A push that makes no SBOMs for its destination has the image's own.
image_push(
    name = "push_without_automatic_referrers",
    image = ":index",
    push_automatic_referrers = "disabled",
    registry = "ghcr.io",
    repository = "buildbarn/index",
)

filegroup(
    name = "unnamed_push_sboms",
    srcs = [":push_without_automatic_referrers"],
    output_group = "sbom",
)

filegroup(
    name = "deploy_manifest",
    srcs = [":deploy"],
    output_group = "deploy_manifest",
)

go_test(
    name = "sbom_test",
    srcs = ["sbom_test.go"],
    args = [
        "-image_digest=$(rootpath :image_digest)",
        "-base_manifest=" + AMD64,
        "-base_sbom=" + SBOM,
    ],
    data = [
        ":deploy",
        ":deploy_manifest",
        ":deploy_sboms",
        ":image_digest",
        ":image_sbom",
        ":index_sboms",
        ":push_sboms",
        ":unnamed_push_sboms",
    ],
    env = {
        "DEPLOY_MANIFEST": "$(rootpath :deploy_manifest)",
        "DEPLOY_SBOMS": "$(rootpaths :deploy_sboms)",
        "IMAGE_SBOMS": "$(rootpaths :image_sbom)",
        "INDEX_SBOMS": "$(rootpaths :index_sboms)",
        "PUSH_SBOMS": "$(rootpaths :push_sboms)",
        "UNNAMED_PUSH_SBOMS": "$(rootpaths :unnamed_push_sboms)",
    },
    deps = [
        "@com_github_cyclonedx_cyclonedx_go//:cyclonedx-go",
        "@com_github_spdx_tools_golang//json",
        "@com_github_spdx_tools_golang//spdx",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# The children of an index publish no SBOMs of their own (see toolchain_test.bzl).
sbom_toolchain(
    name = "dropping_toolchain_impl",
    child_sboms = "drop",
    formats = [
        "cyclonedx",
        "spdx",
    ],
)

toolchain(
    name = "dropping_toolchain",
    toolchain = ":dropping_toolchain_impl",
    toolchain_type = "@rules_img//img:automatic_referrers_toolchain_type",
)

drops_children_test(
    name = "drops_children_test",
    target_under_test = ":index",
)

sbom_toolchain(
    name = "dangling_references_toolchain",
    child_sboms = "drop",
    index_sbom = "reference",
    tags = ["manual"],
)

rejects_dangling_references_test(
    name = "rejects_dangling_references_test",
    target_under_test = ":dangling_references_toolchain",
)
