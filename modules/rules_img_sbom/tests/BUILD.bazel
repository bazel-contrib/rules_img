# The test is written by hand: its arguments come from the image targets.
# gazelle:ignore

load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_go//go:def.bzl", "go_test")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "image_layer")

# A pulled image without the network: the fixture of a pull repository rule.
load("@rules_img//img/private:import.bzl", "image_import")  # buildifier: disable=bzl-visibility
load("//sbom:toolchain.bzl", "sbom_toolchain")
load(":fixture.bzl", "AMD64", "DATA", "INDEX", "SBOM", "files")
load(":toolchain_test.bzl", "drops_children_test", "rejects_dangling_references_test")

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

image_import(
    name = "base",
    data = DATA,
    digest = INDEX,
    files = files(":placeholder.json", ":base.cdx.json"),
    referrers = [SBOM],
    registries = ["registry.example.com"],
    repository = "example/base",
)

package_metadata(
    name = "hello_metadata",
    purl = "pkg:generic/hello@1.0.0",
)

genrule(
    name = "hello",
    outs = ["hello.txt"],
    cmd = "echo hello > $@",
)

image_layer(
    name = "layer",
    srcs = {"/hello.txt": ":hello"},
    package_metadata = [":hello_metadata"],
)

image_manifest(
    name = "image",
    base = ":base",
    layers = [":layer"],
    platform = ":linux_amd64",
)

image_manifest(
    name = "image_arm64",
    layers = [":layer"],
    platform = ":linux_arm64",
)

image_index(
    name = "index",
    manifests = [
        ":image",
        ":image_arm64",
    ],
)

filegroup(
    name = "image_sbom",
    srcs = [":image"],
    output_group = "sbom",
)

filegroup(
    name = "image_digest",
    srcs = [":image"],
    output_group = "digest",
)

filegroup(
    name = "index_sboms",
    srcs = [":index"],
    output_group = "sbom",
)

go_test(
    name = "sbom_test",
    srcs = ["sbom_test.go"],
    args = [
        "-image_digest=$(rootpath :image_digest)",
        "-base_manifest=" + AMD64,
        "-base_sbom=" + SBOM,
    ],
    data = [
        ":image_digest",
        ":image_sbom",
        ":index_sboms",
    ],
    env = {
        "IMAGE_SBOMS": "$(rootpaths :image_sbom)",
        "INDEX_SBOMS": "$(rootpaths :index_sboms)",
    },
    deps = [
        "@com_github_cyclonedx_cyclonedx_go//:cyclonedx-go",
        "@com_github_spdx_tools_golang//json",
        "@com_github_spdx_tools_golang//spdx",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# The children of an index publish no SBOMs of their own (see toolchain_test.bzl).
sbom_toolchain(
    name = "dropping_toolchain_impl",
    child_sboms = "drop",
    formats = [
        "cyclonedx",
        "spdx",
    ],
)

toolchain(
    name = "dropping_toolchain",
    toolchain = ":dropping_toolchain_impl",
    toolchain_type = "@rules_img//img:automatic_referrers_toolchain_type",
)

drops_children_test(
    name = "drops_children_test",
    target_under_test = ":index",
)

sbom_toolchain(
    name = "dangling_references_toolchain",
    child_sboms = "drop",
    index_sbom = "reference",
    tags = ["manual"],
)

rejects_dangling_references_test(
    name = "rejects_dangling_references_test",
    target_under_test = ":dangling_references_toolchain",
)
