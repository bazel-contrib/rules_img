load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "img-sbom_lib",
    srcs = [
        "main.go",
        "scan_layer.go",
        "set_destination.go",
    ],
    importpath = "github.com/bazel-contrib/rules_img_sbom/cmd/img-sbom",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/bom",
        "//internal/graph",
        "//internal/layerscan",
        "//internal/scan",
    ],
)

go_binary(
    name = "img-sbom",
    embed = [":img-sbom_lib"],
    visibility = ["//visibility:public"],
)
