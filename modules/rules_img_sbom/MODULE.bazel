module(
    name = "rules_img_sbom",
    version = "0.0.1",
)

# Needs a rules_img with automatic referrers (the release after 0.3.26).
bazel_dep(name = "rules_img", version = "0.3.26")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.0.0")

# Resolve the SBOM writer (img-sbom): released versions ship a populated
# prebuilt_lockfile.json and download the prebuilt binary for the exec platform.
prebuilt = use_extension("//prebuilt:prebuilt.bzl", "prebuilt_tool")
prebuilt.from_file(
    basename = "img-sbom",
    lockfile = "//:prebuilt_lockfile.json",
)
use_repo(prebuilt, "rules_img_sbom_resolved")

### REMOVE_BEFORE_RELEASE_START

# Stripped when the release archive is produced: the released module ships
# prebuilt binaries and no Go sources, so it must not depend on rules_go/gazelle.

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_bazel_contrib_supply_chain_lib_supplychain_go",
    "com_github_cyclonedx_cyclonedx_go",
    "com_github_google_uuid",
    "com_github_package_url_packageurl_go",
    "com_github_spdx_tools_golang",
    "com_github_stretchr_testify",
)

# Used whenever prebuilt_lockfile.json is still the empty list `[]`.
prebuilt.source(target = "//cmd/img-sbom")

# NOTE: building this module *from source* needs the BUILD files of
# supplychain-go regenerated: they load @gazelle, which a Go repository can't
# see. gazelle_override is a ROOT-module-only tag, so when building from source
# (e.g. a git_override), add this to your ROOT MODULE.bazel (it is declared below
# for development of this module):
#
#   go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
#   go_deps.gazelle_override(
#       build_file_generation = "clean",
#       path = "github.com/bazel-contrib/supply-chain/lib/supplychain-go",
#   )

### Development ###

go_deps_dev = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_dev.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/bazel-contrib/supply-chain/lib/supplychain-go",
)

bazel_dep(name = "package_metadata", version = "0.0.13", dev_dependency = True)
bazel_dep(name = "rules_img_tool", version = "0.3.26", dev_dependency = True)

local_path_override(
    module_name = "rules_img",
    path = "../..",
)

local_path_override(
    module_name = "rules_img_tool",
    path = "../../img_tool",
)

# The img tool built from source (the prebuilt lockfile of an unreleased
# rules_img is empty), and this module's own SBOM toolchain for the tests.
register_toolchains(
    "@rules_img_tool//toolchain:all",
    "//toolchains:cyclonedx_and_spdx",
    dev_dependency = True,
)

### REMOVE_BEFORE_RELEASE_END
