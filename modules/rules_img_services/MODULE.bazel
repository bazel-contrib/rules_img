module(name = "rules_img_services")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_img", version = "0.3.26")
bazel_dep(name = "rules_img_internal_tools", version = "0.0.1")
bazel_dep(name = "rules_img_private", version = "0.0.1")
bazel_dep(name = "rules_img_sbom", version = "0.0.1")
bazel_dep(name = "rules_img_signer_cosign", version = "0.0.1")
bazel_dep(name = "rules_img_tool", version = "0.3.26")

# This workspace is a separate root module, so rules_img's dev-only SDK
# selection does not apply. Select the SDK here as well, including for Gazelle
# dependency fetches, which otherwise use rules_go's older default SDK.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.3")  # Keep in sync with the root MODULE.bazel.

register_toolchains("@rules_img_tool//toolchain:all")

# Every published image gets a CycloneDX and an SPDX SBOM, pushed (and signed)
# along with it as OCI referrers.
register_toolchains("@rules_img_sbom//toolchains:cyclonedx_and_spdx")

# rules_img_sbom is overridden to its source here (see .bazelrc), so it builds its
# SBOM writer from source; one of its Go dependencies ships BUILD files that need
# regenerating, which only the root module can ask for. (A released rules_img_sbom
# downloads a prebuilt SBOM writer and needs none of this.)
bazel_dep(name = "gazelle", version = "0.54.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/bazel-contrib/supply-chain/lib/supplychain-go",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "curl_ca_certs",
    integrity = "sha256-P/NE4wubHtKXEETqu0OKCPLiJF3bX4qxo62LY6tOr5E=",
    urls = ["https://curl.se/ca/cacert-2026-07-16.pem"],
)
