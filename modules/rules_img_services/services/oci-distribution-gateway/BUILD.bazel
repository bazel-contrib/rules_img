load("@rules_img//img:image.bzl", "image_from_binary")
load("@rules_img//img:multi_deploy.bzl", "multi_deploy")

_DESCRIPTION = """\
A container registry gateway that only forwards: clients speak the OCI distribution protocol
to it anonymously and name the upstream registry they want in the X-rules_img-Original-Host header,
and the gateway authenticates to that registry itself and authorizes every request against a policy file.
"""

_DOCUMENTATION = "https://github.com/bazel-contrib/rules_img/tree/main/img_tool/cmd/oci-distribution-gateway"

image_from_binary(
    name = "oci-distribution-gateway",
    annotations = {
        "org.opencontainers.image.title": package_name(),
        "org.opencontainers.image.description": _DESCRIPTION,
        "org.opencontainers.image.documentation": _DOCUMENTATION,
    },
    annotations_file = "//services:image_annotations",
    binary = "@rules_img_tool//cmd/oci-distribution-gateway",
    include_runfiles = False,
    labels = {
        "org.label-schema.name": package_name(),
        "org.label-schema.description": _DESCRIPTION,
        "org.label-schema.usage": _DOCUMENTATION,
    },
    layers = ["//base"],
    path = "/usr/bin/",
    platforms = [
        "//platform:linux_amd64",
        "//platform:linux_arm64",
    ],
    push_specs = ["//services:push_spec"],
    visibility = ["//visibility:public"],
)

multi_deploy(
    name = "push",
    deploy_operations = ["push"],
    operations = [":oci-distribution-gateway"],
    tags = ["manual"],
)
