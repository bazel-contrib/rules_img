load("@rules_img//img:multi_deploy.bzl", "multi_deploy")
load("@rules_img//img:push.bzl", "image_push_spec")
load("@rules_img//img:signing.bzl", "signing_config")

multi_deploy(
    name = "push",
    deploy_operations = ["push"],
    operations = ["//{}/{}".format(
        package_name(),
        sub,
    ) for sub in subpackages(include = ["*"])],
    visibility = ["//:__pkg__"],
)

image_push_spec(
    name = "push_spec",
    repository = "bazel-contrib/rules_img/{{.image_target_name}}",
    visibility = ["//services:__subpackages__"],
)

signing_config(
    name = "cosign_keyless",
    targets = [
        "roots",
        "child_manifests",
    ],
    tool = "@rules_img_signer_cosign",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "image_labels",
    srcs = ["labels.json"],
    visibility = ["//services:__subpackages__"],
)

filegroup(
    name = "image_annotations",
    srcs = ["annotations.json"],
    visibility = ["//services:__subpackages__"],
)
