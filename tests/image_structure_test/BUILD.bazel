load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_img//img:convert.bzl", "image_flatten", "image_index_from_archive", "image_index_from_oci_layout", "image_manifest_from_archive", "image_manifest_from_oci_layout")
load("@rules_img//img:image.bzl", "image_index", "image_manifest", "image_optimize")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer", "layer_from_binary")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:media_types.bzl", "GZIP_LAYER", "ZSTD_LAYER")
load("@rules_img//img:test.bzl", "image_structure_test")
load(":defs.bzl", "mtree_config_output_groups", "simple_binary")

# gazelle:exclude_from_release

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
    visibility = ["//img/private/release:__subpackages__"],
)

write_file(
    name = "hello_txt",
    out = "hello.txt",
    content = ["hello\n"],
)

write_file(
    name = "tool_sh",
    out = "tool.sh",
    content = ["#!/bin/sh\necho hi\n"],
)

image_layer(
    name = "hello_layer",
    srcs = {"/etc/hello.txt": ":hello_txt"},
    default_metadata = file_metadata(
        gid = 1000,
        mode = "0644",
        mtime = "2023-01-01T00:00:00Z",
        uid = 1000,
    ),
)

image_layer(
    name = "tool_layer",
    srcs = {"/usr/local/bin/tool": ":tool_sh"},
    default_metadata = file_metadata(
        mode = "0755",
        mtime = "2023-01-01T00:00:00Z",
    ),
)

image_manifest(
    name = "hello",
    env = {
        "FOO": "bar",
        "GREETING": "hello-world",
    },
    labels = {"org.opencontainers.image.title": "hello"},
    layers = [
        ":hello_layer",
        ":tool_layer",
    ],
    working_dir = "/app",
)

# Single-platform image (rules_img image_manifest -> ImageManifestInfo branch).
image_structure_test(
    name = "hello_test",
    size = "small",
    configs = ["hello.yaml"],
    image = ":hello",
)

# Output-group source: a target that publishes prebuilt `mtree` + `oci_image_config`
# output groups (and no ImageManifestInfo) -> the aspect's output-group branch.
mtree_config_output_groups(
    name = "hello_output_groups",
    image = ":hello",
)

image_structure_test(
    name = "hello_output_groups_test",
    size = "small",
    configs = ["hello.yaml"],
    image = ":hello_output_groups",
)

# Platforms for the multi-platform index.
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

# Multi-platform image (rules_img image_index -> ImageIndexInfo branch): every
# config is validated against each single-platform image.
image_index(
    name = "hello_index",
    manifests = [":hello"],
    platforms = [
        ":linux_amd64",
        ":linux_arm64",
    ],
)

image_structure_test(
    name = "hello_index_test",
    size = "small",
    configs = ["hello.yaml"],
    image = ":hello_index",
)

# rules_oci compatibility (hermetic stand-in): an OCI image layout directory (a
# tree artifact) exercises the aspect's DefaultInfo tree-artifact branch, driven
# by `img oci-layout-metadata`. We reuse rules_img's own `oci_layout` output
# group as a stand-in for a rules_oci `oci_image`; the layout (with blobs) is
# only an action input to the extraction step and never reaches the test runfiles.
filegroup(
    name = "hello_oci_layout",
    srcs = [":hello"],
    output_group = "oci_layout",
)

image_structure_test(
    name = "hello_oci_test",
    size = "small",
    configs = ["hello.yaml"],
    image = ":hello_oci_layout",
)

# rules_oci multi-platform stand-in: the `oci_layout` of an image_index is a full
# OCI layout whose index.json lists every platform manifest -- like a rules_oci
# `oci_image_index`. This exercises `img oci-layout-metadata`'s multi-manifest
# path (each config runs against each platform image).
filegroup(
    name = "hello_index_oci_layout",
    srcs = [":hello_index"],
    output_group = "oci_layout",
)

image_structure_test(
    name = "hello_index_oci_test",
    size = "small",
    configs = ["hello.yaml"],
    image = ":hello_index_oci_layout",
)

# image_optimize -> ImageManifestInfo.mtree computed from the recompressed layers.
image_optimize(
    name = "hello_optimized",
    image = ":hello",
)

image_structure_test(
    name = "hello_optimized_test",
    size = "small",
    configs = ["hello.yaml"],
    image = ":hello_optimized",
)

# image_manifest_from_oci_layout -> mtree rendered from the layout's tar layers.
# Reuse the fixed-platform index layout and pick its linux/amd64 manifest.
image_manifest_from_oci_layout(
    name = "hello_from_layout",
    src = ":hello_index_oci_layout",
    architecture = "amd64",
    layers = [
        GZIP_LAYER,
        GZIP_LAYER,
    ],
    os = "linux",
)

image_structure_test(
    name = "hello_from_layout_test",
    size = "small",
    configs = ["hello.yaml"],
    image = ":hello_from_layout",
)

# image_index_from_oci_layout -> per-manifest mtree (exercises unique naming).
image_index_from_oci_layout(
    name = "hello_index_from_layout",
    src = ":hello_index_oci_layout",
    layers = [
        GZIP_LAYER,
        GZIP_LAYER,
    ],
    manifests = [
        "linux/amd64",
        "linux/arm64",
    ],
)

image_structure_test(
    name = "hello_index_from_layout_test",
    size = "small",
    configs = ["hello.yaml"],
    image = ":hello_index_from_layout",
)

# Archive conversion and single/multi-platform image_flatten tests.
# Short target names keep Windows MAX_PATH (<260 chars) headroom for sparse_oci_layout trees.
_MULTI_PLATFORMS = [
    "linux/amd64",
    "linux/arm64",
]

filegroup(
    name = "oci_tar",
    srcs = [":hello_index"],
    output_group = "oci_tarball",
)

image_load(
    name = "dkr_load",
    image = ":hello_from_layout",
    tag = "example.com/hello:latest",
)

filegroup(
    name = "dkr_tar",
    srcs = [":dkr_load"],
    output_group = "tarball",
)

image_load(
    name = "idx_dkr_load",
    image = ":hello_index_from_layout",
    tag = "example.com/hello:multiarch",
)

filegroup(
    name = "idx_dkr_tar",
    srcs = [":idx_dkr_load"],
    output_group = "tarball",
)

[
    image_manifest_from_archive(
        name = name,
        src = src,
        architecture = "amd64",
        layers = [
            layer_mt,
            layer_mt,
        ],
        os = "linux",
    )
    for name, src, layer_mt in [
        ("arch_oci_gz", ":oci_tar", GZIP_LAYER),
        ("arch_oci_zst", ":oci_tar", ZSTD_LAYER),
        ("arch_dkr_gz", ":dkr_tar", GZIP_LAYER),
    ]
]

[
    image_index_from_archive(
        name = name,
        src = src,
        layers = [
            layer_mt,
            layer_mt,
        ],
        manifests = _MULTI_PLATFORMS,
    )
    for name, src, layer_mt in [
        ("idx_arch_gz", ":oci_tar", GZIP_LAYER),
        ("idx_arch_zst", ":oci_tar", ZSTD_LAYER),
        ("idx_arch_dkr", ":idx_dkr_tar", ZSTD_LAYER),
    ]
]

image_flatten(
    name = "flat_manifest",
    compress = "zstd",
    history = [],
    image = ":hello",
)

[
    image_flatten(
        name = name,
        src = src,
        architecture = "amd64",
        compress = "zstd",
        os = "linux",
    )
    for name, src in [
        ("flat_dir", ":hello_index_oci_layout"),
        ("flat_oci_tar", ":oci_tar"),
        ("flat_dkr_tar", ":dkr_tar"),
    ]
]

image_flatten(
    name = "flat_idx_prov",
    compress = "zstd",
    image = ":hello_index_from_layout",
)

[
    image_flatten(
        name = name,
        src = src,
        compress = "zstd",
        manifests = _MULTI_PLATFORMS,
    )
    for name, src in [
        ("flat_idx_dir", ":hello_index_oci_layout"),
        ("flat_idx_oci", ":oci_tar"),
        ("flat_idx_dkr", ":idx_dkr_tar"),
    ]
]

filegroup(
    name = "flat_dkr_oci",
    srcs = [":flat_dkr_tar"],
    output_group = "oci_layout",
)

filegroup(
    name = "flat_idx_oci_out",
    srcs = [":flat_idx_dkr"],
    output_group = "oci_layout",
)

[
    image_structure_test(
        name = target + "_test",
        size = "small",
        configs = ["hello.yaml"],
        image = ":" + target,
    )
    for target in [
        "arch_oci_gz",
        "arch_oci_zst",
        "arch_dkr_gz",
        "idx_arch_gz",
        "idx_arch_zst",
        "idx_arch_dkr",
        "flat_manifest",
        "flat_dir",
        "flat_oci_tar",
        "flat_dkr_tar",
        "flat_dkr_oci",
        "flat_idx_prov",
        "flat_idx_dir",
        "flat_idx_oci",
        "flat_idx_dkr",
        "flat_idx_oci_out",
    ]
]

# Extending flattened images as `base` in image_manifest preserves both the
# flattened filesystem and inherited config (Env, WorkingDir, Labels; #809).
[
    (
        image_manifest(
            name = name,
            base = base,
            layers = [":launcher_layer_no_infer"],
            platform = ":linux_amd64",
        ),
        image_structure_test(
            name = name + "_test",
            size = "small",
            configs = [
                "base_workdir.yaml",
                "hello.yaml",
            ],
            image = ":" + name,
        ),
    )
    for name, base in [
        ("ext_flat_dir", ":flat_dir"),
        ("ext_flat_dkr", ":flat_dkr_tar"),
    ]
]

# Negative cases (run manually to confirm the driver fails loudly):
#   bazel test //tests/image_structure_test:hello_unsupported_test  # -> fails: commandTests unsupported
#   bazel test //tests/image_structure_test:hello_failing_test      # -> fails: assertion mismatch
image_structure_test(
    name = "hello_unsupported_test",
    size = "small",
    configs = ["unsupported.yaml"],
    image = ":hello",
    tags = ["manual"],
)

image_structure_test(
    name = "hello_failing_test",
    size = "small",
    configs = ["failing.yaml"],
    image = ":hello",
    tags = ["manual"],
)

# working_dir precedence between a base image, a layer's ImageLayerConfigInfo and
# the image_manifest attribute. The base (`:hello`) sets /app, and
# layer_from_binary infers a runfiles working directory unless told not to.
simple_binary(
    name = "launcher",
    binary = ":tool_sh",
    data = [":hello_txt"],
)

layer_from_binary(
    name = "launcher_layer",
    binary = ":launcher",
    path = "/opt/launcher",
    runfiles_sharing_mode = "private",
)

layer_from_binary(
    name = "launcher_layer_no_infer",
    binary = ":launcher",
    infer_working_dir = False,
    path = "/opt/launcher",
    runfiles_sharing_mode = "private",
)

# Inferred: the layer's working_dir wins over the base image's /app.
image_manifest(
    name = "launcher_inferred_workdir",
    base = ":hello",
    layers = [":launcher_layer"],
)

image_structure_test(
    name = "launcher_inferred_workdir_test",
    size = "small",
    configs = ["inferred_workdir.yaml"],
    image = ":launcher_inferred_workdir",
)

# Not inferred: the layer carries no opinion, so the base image's /app is kept.
image_manifest(
    name = "launcher_base_workdir",
    base = ":hello",
    layers = [":launcher_layer_no_infer"],
)

image_structure_test(
    name = "launcher_base_workdir_test",
    size = "small",
    configs = ["base_workdir.yaml"],
    image = ":launcher_base_workdir",
)

# An explicit attribute wins over both.
image_manifest(
    name = "launcher_explicit_workdir",
    base = ":hello",
    layers = [":launcher_layer_no_infer"],
    working_dir = "/explicit",
)

image_structure_test(
    name = "launcher_explicit_workdir_test",
    size = "small",
    configs = ["explicit_workdir.yaml"],
    image = ":launcher_explicit_workdir",
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["@rules_img//img:providers"],
)
