load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_img//img:layer.bzl", "image_layer")
load("//tests/layering:defs.bzl", "layer_contents_test")

# gazelle:exclude_from_release

write_file(
    name = "a",
    out = "a.txt",
    content = ["a\n"],
)

write_file(
    name = "b",
    out = "nested/b.txt",
    content = ["b\n"],
)

write_file(
    name = "single",
    out = "single.txt",
    content = ["single\n"],
)

write_file(
    name = "only",
    out = "sub/only.txt",
    content = ["only\n"],
)

write_file(
    name = "exact",
    out = "sub2/exact.txt",
    content = ["exact\n"],
)

filegroup(
    name = "files",
    srcs = [
        ":a",
        ":b",
    ],
)

# Filegroups that happen to hold exactly one file, nested in a subdirectory.
# Bazel reports the single file as such a filegroup's executable (so that
# `bazel run` works on it), but it is a plain file set, not a binary.
filegroup(
    name = "single_nested",
    srcs = [":only"],
)

filegroup(
    name = "single_exact",
    srcs = [":exact"],
)

# srcs keys ending in "/" are treated as directories, so the outputs of a target
# are laid out inside them the same way no matter how many outputs there are:
# - a multi-output target is placed package-relative beneath the directory, with
#   the trailing slash normalized (no doubled slash);
# - a target with a single output is placed package-relative too, keeping the
#   file's subdirectory instead of collapsing onto the key.
# A key without a trailing slash keeps the single-output shortcut: the file is
# placed exactly at the key.
image_layer(
    name = "layer",
    srcs = {
        "/opt/data/": ":files",
        "/opt/exact.txt": ":single_exact",
        "/opt/nested/": ":single_nested",
        "/opt/solo/": ":single",
    },
)

layer_contents_test(
    name = "test",
    size = "small",
    layer = ":layer",
    manifests = ["expected.ndjson"],
)
