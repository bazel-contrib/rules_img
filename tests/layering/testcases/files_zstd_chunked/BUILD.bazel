load("@rules_img//img:layer.bzl", "image_layer")
load("//tests/layering:defs.bzl", "layer_contents_test")

# gazelle:exclude_from_release

# Same files as the `files` case, written in the zstd:chunked format. The
# format wraps the unmodified tar stream in per-chunk zstd frames and appends
# its TOC and tar-split data in skippable frames, so a plain zstd decoder sees
# exactly the tar that was built and the `files` golden applies unchanged. The
# compact-stream half of the test re-runs the content-defined chunker during
# reconstruction, which must be deterministic for the blob digest to match.
image_layer(
    name = "layer",
    srcs = {
        "/etc/app/config.txt": "//tests/layering/testcases:config_txt",
        "/etc/app/config_copy.txt": "//tests/layering/testcases:config_dup_txt",
        "/usr/share/data/deep.txt": "//tests/layering/testcases:deep_txt",
    },
    compress = "zstd",
    symlinks = {
        "/etc/app/current.txt": "/etc/app/config.txt",
    },
    zstd_chunked = "enabled",
)

layer_contents_test(
    name = "test",
    size = "small",
    layer = ":layer",
    manifests = ["//tests/layering/testcases/files:expected.ndjson"],
)
