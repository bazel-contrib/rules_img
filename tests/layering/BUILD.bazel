load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":defs.bzl", "binary_with_runfiles_groups_describer")

# gazelle:exclude_from_release

# Shared rule definitions for the layering test suite. The actual test cases
# (layers, manifests, and fixtures) live in //tests/layering/testcases. The Go
# tooling lives in //tests/layering/{manifest,verifier,generate_golden}.

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_img//img:providers",
        "@rules_runfiles_group//runfiles_group:lib",
    ],
)

bzl_library(
    name = "empty_runfiles_repo",
    srcs = ["empty_runfiles_repo.bzl"],
    visibility = ["//visibility:public"],
)

# The runfiles group describer of the binary_with_runfiles_groups fixture.
binary_with_runfiles_groups_describer(
    name = "binary_with_runfiles_groups_describer",
    visibility = ["//tests/layering:__subpackages__"],
)
