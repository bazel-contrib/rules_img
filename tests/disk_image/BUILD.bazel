load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_img//img:dd.bzl", "image_dd")
load("@rules_img//img:disk_image.bzl", "disk_image", "disk_partition")
load("@rules_img//img:layer.bzl", "image_layer")
load(":defs.bzl", "with_compact_layers")

# gazelle:exclude_from_release

genrule(
    name = "bootloader",
    outs = ["BOOTX64.EFI"],
    cmd = "head -c 150000 /dev/zero | tr '\\0' 'b' > $@",
)

genrule(
    name = "loader_conf",
    outs = ["loader.conf"],
    cmd = "echo 'default linux' > $@",
)

genrule(
    name = "payload",
    outs = ["payload.bin"],
    cmd = "head -c 3000000 /dev/zero | tr '\\0' 'r' > $@",
)

genrule(
    name = "os_release",
    outs = ["os-release"],
    cmd = "echo 'NAME=disk-image-test' > $@",
)

image_layer(
    name = "esp_layer",
    srcs = {
        "/EFI/BOOT/BOOTX64.EFI": ":bootloader",
        "/loader/loader.conf": ":loader_conf",
    },
    format = "fat32",
)

image_layer(
    name = "root_ext4",
    srcs = {
        "/etc/os-release": ":os_release",
        "/usr/lib/payload": ":payload",
    },
    format = "ext4",
)

image_layer(
    name = "root_erofs",
    srcs = {
        "/etc/os-release": ":os_release",
        "/usr/lib/payload": ":payload",
    },
    compress = "none",
    format = "erofs",
)

disk_partition(
    name = "esp",
    image = ":esp_layer",
    label = "ESP",
    type = "esp",
)

disk_partition(
    name = "scratch",
    label = "scratch",
    partition_size = "8MiB",
)

disk_partition(
    name = "root",
    attributes = ["required"],
    image = ":root_ext4",
    label = "root",
    partition_size = "16MiB",
    type = "root-x86-64",
)

disk_partition(
    name = "root_erofs_partition",
    image = ":root_erofs",
    label = "root",
    type = "root-x86-64",
)

disk_image(
    name = "disk_gpt",
    partitions = [
        ":esp",
        ":scratch",
        ":root",
    ],
)

disk_image(
    name = "disk_gpt_larger",
    min_size = "128MiB",
    partitions = [
        ":esp",
        ":root",
    ],
)

disk_partition(
    name = "esp_active",
    active = True,
    image = ":esp_layer",
    label = "ESP",
    type = "esp",
)

disk_partition(
    name = "root_mbr",
    image = ":root_ext4",
    label = "root",
)

disk_image(
    name = "disk_mbr",
    partition_table = "mbr",
    partitions = [
        ":esp_active",
        ":root_mbr",
    ],
)

# The same disk as an extent stream, with the layer built as a compact stream
# too (which the erofs layer supports), so that the extent stream of the disk
# references the compact stream of the layer.
disk_image(
    name = "disk_erofs",
    extent_stream = "enabled",
    partitions = [
        ":esp",
        ":root_erofs_partition",
    ],
)

with_compact_layers(
    name = "disk_erofs_compact_layers",
    dep = ":disk_erofs",
)

# The same disk, built as an image, to compare with.
disk_image(
    name = "disk_erofs_raw",
    extent_stream = "disabled",
    partitions = [
        ":esp",
        ":root_erofs_partition",
    ],
)

# A disk with four partitions, which an image_dd target needs five
# content-addressed directories for: one per partition, and one for the disk
# itself. The launcher of the target embeds at most ten arguments, so they are
# passed in a file instead of a --cas-dir flag each.
image_layer(
    name = "var_erofs",
    srcs = {"/var/lib/payload": ":payload"},
    compress = "none",
    format = "erofs",
)

image_layer(
    name = "home_erofs",
    srcs = {"/home/user/os-release": ":os_release"},
    compress = "none",
    format = "erofs",
)

disk_partition(
    name = "var_partition",
    image = ":var_erofs",
    label = "var",
    type = "var",
)

disk_partition(
    name = "home_partition",
    image = ":home_erofs",
    label = "home",
    type = "home",
)

disk_image(
    name = "disk_four",
    extent_stream = "enabled",
    partitions = [
        ":esp",
        ":root_erofs_partition",
        ":var_partition",
        ":home_partition",
    ],
)

with_compact_layers(
    name = "disk_four_compact_layers",
    dep = ":disk_four",
)

image_dd(
    name = "disk_four_dd",
    image = ":disk_four_compact_layers",
    strategy = "eager",
)

filegroup(
    name = "disk_four_image",
    srcs = [":disk_four_compact_layers"],
    output_group = "image",
)

genrule(
    name = "disk_four_written",
    outs = ["disk_four_written.img"],
    cmd = "$(location :disk_four_dd) of=$@ bs=64K status=none",
    tools = [":disk_four_dd"],
)

# The bytes written are the disk image: the target found every directory.
diff_test(
    name = "dd_writes_a_disk_with_four_partitions_test",
    file1 = ":disk_four_image",
    file2 = ":disk_four_written",
)

filegroup(
    name = "disk_erofs_xstream",
    srcs = [":disk_erofs_compact_layers"],
    output_group = "extent_stream",
)

filegroup(
    name = "disk_erofs_cas",
    srcs = [":disk_erofs_compact_layers"],
    output_group = "cas",
)

filegroup(
    name = "disk_erofs_lazy_image",
    srcs = [":disk_erofs_compact_layers"],
    output_group = "image",
)

genrule(
    name = "disk_erofs_reconstructed",
    srcs = [
        ":disk_erofs_cas",
        ":disk_erofs_xstream",
    ],
    outs = ["disk_erofs_reconstructed.img"],
    cmd = """
dirs=""
for d in $(locations :disk_erofs_cas); do dirs="$$dirs --cas-dir $$d"; done
$(location @rules_img_tool//cmd/img) extent-stream reconstruct --extent-stream $(location :disk_erofs_xstream) $$dirs --output $@
""",
    tools = ["@rules_img_tool//cmd/img"],
)

# The extent stream reconstructs to the disk image.
diff_test(
    name = "extent_stream_reconstructs_to_the_disk_test",
    file1 = ":disk_erofs_lazy_image",
    file2 = ":disk_erofs_reconstructed",
)

# The extent stream of the disk is small: the partitions are references.
genrule(
    name = "check_extent_stream_is_small",
    srcs = [":disk_erofs_xstream"],
    outs = ["extent_stream_is_small"],
    cmd = """
size=$$(wc -c < $(location :disk_erofs_xstream))
[ "$$size" -lt 4096 ] || { echo "the extent stream is $$size bytes" >&2; exit 1; }
touch $@
""",
)

# Runnable targets that write a disk image, or a layer, like dd. The extent stream and the
# content-addressed directories are its runfiles (eager), or only the extent
# stream (lazy: the rest has to be fetched from a cache).
image_dd(
    name = "disk_erofs_dd",
    image = ":disk_erofs_compact_layers",
    strategy = "eager",
)

image_dd(
    name = "disk_erofs_dd_lazy",
    image = ":disk_erofs_compact_layers",
    strategy = "lazy",
)

# It also writes a raw disk image, and layers: a file system image, and an erofs
# layer built as a compact stream (which references the files it was made of).
with_compact_layers(
    name = "root_erofs_compact",
    dep = ":root_erofs",
)

image_dd(
    name = "root_ext4_dd",
    image = ":root_ext4",
)

image_dd(
    name = "root_erofs_dd",
    image = ":root_erofs_compact",
    strategy = "eager",
)

image_dd(
    name = "root_erofs_dd_lazy",
    image = ":root_erofs_compact",
    strategy = "lazy",
)

image_dd(
    name = "disk_gpt_dd",
    image = ":disk_gpt",
)

# Lazily, a file is not in the runfiles, only its digest and size.
image_dd(
    name = "disk_gpt_dd_lazy",
    image = ":disk_gpt",
    strategy = "lazy",
)

image_dd(
    name = "root_ext4_dd_lazy",
    image = ":root_ext4",
    strategy = "lazy",
)

genrule(
    name = "disk_erofs_written",
    outs = ["disk_erofs_written.img"],
    cmd = "$(location :disk_erofs_dd) of=$@ bs=64K status=none",
    tools = [":disk_erofs_dd"],
)

# The disk written by the target is the disk image.
diff_test(
    name = "dd_writes_the_disk_test",
    file1 = ":disk_erofs_lazy_image",
    file2 = ":disk_erofs_written",
)

# With compact = "enabled", the disk is built as an extent stream with compact layers without
# the command line asking for it, and the bytes written are the same.
disk_image(
    name = "disk_erofs_default",
    partitions = [
        ":esp",
        ":root_erofs_partition",
    ],
)

image_dd(
    name = "disk_erofs_dd_compact",
    compact = "enabled",
    image = ":disk_erofs_default",
    strategy = "eager",
)

genrule(
    name = "disk_erofs_compact_written",
    outs = ["disk_erofs_compact_written.img"],
    cmd = "$(location :disk_erofs_dd_compact) of=$@ bs=64K status=none",
    tools = [":disk_erofs_dd_compact"],
)

diff_test(
    name = "dd_compact_writes_the_disk_test",
    file1 = ":disk_erofs_written",
    file2 = ":disk_erofs_compact_written",
)

genrule(
    name = "root_ext4_written",
    outs = ["root_ext4_written.ext4"],
    cmd = "$(location :root_ext4_dd) of=$@ status=none",
    tools = [":root_ext4_dd"],
)

diff_test(
    name = "dd_writes_a_layer_test",
    file1 = ":root_ext4",
    file2 = ":root_ext4_written",
)

genrule(
    name = "root_erofs_written",
    outs = ["root_erofs_written.erofs"],
    cmd = "$(location :root_erofs_dd) of=$@ status=none",
    tools = [":root_erofs_dd"],
)

# The compact stream of the layer is reconstructed to the layer file.
diff_test(
    name = "dd_writes_a_compact_layer_test",
    file1 = ":root_erofs",
    file2 = ":root_erofs_written",
)

genrule(
    name = "disk_gpt_written",
    outs = ["disk_gpt_written.img"],
    cmd = "$(location :disk_gpt_dd) of=$@ status=none",
    tools = [":disk_gpt_dd"],
)

diff_test(
    name = "dd_writes_a_raw_disk_test",
    file1 = ":disk_gpt",
    file2 = ":disk_gpt_written",
)

# Stdout, skip and count: the bytes are those of the disk image.
genrule(
    name = "check_dd_stdout_skip_count",
    srcs = [":disk_erofs_lazy_image"],
    outs = ["dd_stdout_skip_count_ok"],
    cmd = """
disk="$(location :disk_erofs_lazy_image)"
dd="$(location :disk_erofs_dd)"
work="$(RULEDIR)/dd_stdout_skip_count.tmp"
mkdir -p "$$work"
trap 'rm -rf "$$work"' EXIT
$$dd status=none | cmp - "$$disk" || { echo "stdout differs from the disk image" >&2; exit 1; }
# The same range through dd(1), which is what `img dd` imitates. No `tail | head`:
# head exits early, and the SIGPIPE it sends fails the pipeline under pipefail.
dd if="$$disk" bs=4096 skip=3 count=5 of="$$work/want.bin" 2>/dev/null
$$dd bs=4096 skip=3 count=5 status=none > "$$work/got.bin"
cmp "$$work/got.bin" "$$work/want.bin" || { echo "skip and count differ" >&2; exit 1; }
# The target already passes the image, so a second if= has to be an error
# instead of silently writing something else.
$$dd if=also-an-image 2>"$$work/err" && { echo "a second if= was not rejected" >&2; exit 1; }
grep -q "more than once" "$$work/err" || { cat "$$work/err" >&2; exit 1; }
touch $@
""",
    tools = [":disk_erofs_dd"],
)

# Without the files the extent stream references, the lazy target needs a cache
# and says so. The caches are unset explicitly: a developer or a CI machine that
# has one configured in the environment would otherwise find the blobs.
genrule(
    name = "check_dd_lazy_needs_a_cache",
    outs = ["dd_lazy_needs_a_cache_ok"],
    cmd = """
work="$(RULEDIR)/dd_lazy_needs_a_cache.tmp"
mkdir -p "$$work"
trap 'rm -rf "$$work"' EXIT
unset IMG_REAPI_ENDPOINT IMG_DISK_CACHE IMG_CAS_CACHE_DIR
for target in $(location :disk_erofs_dd_lazy) $(location :root_erofs_dd_lazy) $(location :disk_gpt_dd_lazy) $(location :root_ext4_dd_lazy); do
    if $$target of=/dev/null status=none 2>"$$work/err"; then
        echo "the lazy target $$target worked without a cache" >&2
        exit 1
    fi
    grep -q IMG_REAPI_ENDPOINT "$$work/err" || { cat "$$work/err" >&2; exit 1; }
done
touch $@
""",
    tools = [
        ":disk_erofs_dd_lazy",
        ":disk_gpt_dd_lazy",
        ":root_erofs_dd_lazy",
        ":root_ext4_dd_lazy",
    ],
)

# Fails the build unless the disks have the structure they should have.
genrule(
    name = "check_disks",
    srcs = [
        ":disk_gpt",
        ":disk_gpt_larger",
        ":disk_mbr",
    ],
    outs = ["disks_ok"],
    cmd = """
gpt="$(location :disk_gpt)"
larger="$(location :disk_gpt_larger)"
mbr="$(location :disk_mbr)"
sig() { dd if="$$1" bs=1 skip="$$2" count="$$3" 2>/dev/null; }
hex() { od -An -tx1 -j"$$2" -N"$$3" "$$1" | tr -d ' \\n'; }
fail() { echo "$$1" >&2; exit 1; }

[ "$$(sig $$gpt 512 8)" = "EFI PART" ] || fail "no GPT header in the second sector"
[ "$$(hex $$gpt 510 2)" = "55aa" ] || fail "no protective MBR signature"
[ "$$(hex $$gpt 450 1)" = "ee" ] || fail "no protective MBR partition"
size=$$(wc -c < $$gpt)
[ "$$(sig $$gpt $$((size - 512)) 8)" = "EFI PART" ] || fail "no backup GPT header in the last sector"
# the ESP starts at 1 MiB with its hidden sectors set to that sector
[ "$$(sig $$gpt $$((1048576 + 82)) 8)" = "FAT32   " ] || fail "no FAT32 file system in the first partition"
[ "$$(od -An -tu4 -j$$((1048576 + 28)) -N4 $$gpt | tr -d ' ')" = "2048" ] || fail "wrong hidden sectors in the ESP"

[ "$$(wc -c < $$larger)" -eq 134217728 ] || fail "the disk with a minimum size is $$(wc -c < $$larger) bytes"
[ "$$(sig $$larger 512 8)" = "EFI PART" ] || fail "no GPT header"
[ "$$(sig $$larger $$((134217728 - 512)) 8)" = "EFI PART" ] || fail "the backup header is not at the end of the larger disk"

[ "$$(hex $$mbr 510 2)" = "55aa" ] || fail "no MBR signature"
[ "$$(hex $$mbr 446 1)" = "80" ] || fail "the ESP is not active"
[ "$$(hex $$mbr 450 1)" = "ef" ] || fail "the ESP does not have the ESP type"
[ "$$(hex $$mbr 466 1)" = "83" ] || fail "the second partition does not have the Linux type"
[ "$$(sig $$mbr 512 8)" != "EFI PART" ] || fail "an MBR disk has a GPT header"
touch $@
""",
)

build_test(
    name = "disk_image_test",
    targets = [
        ":check_dd_lazy_needs_a_cache",
        ":check_dd_stdout_skip_count",
        ":check_extent_stream_is_small",
        ":check_disks",
    ],
)

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
    visibility = ["//img/private/release:__subpackages__"],
)
