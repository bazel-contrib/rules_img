load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "image_layer")

# @alpine_filtered is pulled with platforms = ["linux/amd64", "linux/arm64"], so only those
# children of the index are available - the base image still has to resolve for both.
write_file(
    name = "layer_content",
    out = "file.txt",
    content = ["Hello, World!"],
)

image_layer(
    name = "layer",
    srcs = {"file.txt": ":layer_content"},
)

image_manifest(
    name = "image",
    base = "@alpine_filtered",
    layers = [":layer"],
)

image_index(
    name = "index",
    manifests = [":image"],
    platforms = [
        "//platform:linux_amd64",
        "//platform:linux_arm64",
    ],
)

build_test(
    name = "test",
    targets = [
        ":image",
        ":index",
        ":layer",
    ],
)
