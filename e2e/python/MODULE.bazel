module(name = "python_e2e")

bazel_dep(name = "rules_img_sbom", version = "0.0.1")

register_toolchains("@rules_img_sbom//toolchains:cyclonedx")

# BEGIN BAZEL_DEP
bazel_dep(name = "rules_img")
local_path_override(
    module_name = "rules_img",
    path = "../..",
)

bazel_dep(name = "rules_img_tool")
local_path_override(
    module_name = "rules_img_tool",
    path = "../../img_tool",
)

register_toolchains("@rules_img_tool//toolchain:all")

local_path_override(
    module_name = "rules_img_sbom",
    path = "../../modules/rules_img_sbom",
)

bazel_dep(name = "gazelle", version = "0.54.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/bazel-contrib/supply-chain/lib/supplychain-go",
)
# END BAZEL_DEP

bazel_dep(name = "rules_python", version = "1.9.2")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")  # only exists to upgrade bazel_lib used by aspect_rules_py to a version compatible with Bazel 9
bazel_dep(name = "aspect_rules_py", version = "1.13.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.13",
)
use_repo(python, "python_3_13")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    download_only = True,
    hub_name = "pip",
    python_version = "3.13",
    requirements_lock = "//requirements:requirements_lock.txt",
)
use_repo(pip, "pip")

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "ubuntu",
    digest = "sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db",
    referrer_buildkit_attestations = True,
    registries = [
        "mirror.gcr.io",
        "index.docker.io",
    ],
    repository = "library/ubuntu",
    tag = "latest",
)
