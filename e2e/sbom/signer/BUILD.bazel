load("@rules_img//img:signing.bzl", "signing_config")

# Cosign signer: keyless by default; supply SIGSTORE_ID_TOKEN at deploy time.
# You can also specify a signing key via $RULES_IMG_COSIGN_KEY.
# Enable with --config=cosign (see .bazelrc).
signing_config(
    name = "cosign_keyless",
    targets = [
        "roots",
        "child_manifests",
        "referrers",
    ],
    tool = "@rules_img_signer_cosign",
)

# Cosign signer, key-based & fully offline: never contacts Fulcio/Rekor
# (--tlog-upload=false). The private key comes from $RULES_IMG_COSIGN_KEY at
# deploy time. Used by the integration test runner, which generates a short-lived
# key and points the deploy at a local registry. Enable with --config=cosign.
signing_config(
    name = "cosign_key",
    args = ["--tlog-upload=false"],
    targets = [
        "roots",
        "child_manifests",
        "referrers",
    ],
    tool = "@rules_img_signer_cosign",
)

# Notation signer: supply key and certificate chain at deploy time via
# $RULES_IMG_NOTATION_KEY and $RULES_IMG_NOTATION_CERTIFICATE_CHAIN.
# Enable with --config=notation (see .bazelrc).
signing_config(
    name = "notation",
    args = ["--signature-format=cose"],
    targets = [
        "roots",
        "child_manifests",
        "referrers",
    ],
    tool = "@rules_img_signer_notation",
)

# Provenance: attaches a BuildKit-style SLSA provenance attestation to every
# platform manifest at push time. Nothing is signed, so no key is needed.
# Timestamps are recorded here because the point of attaching provenance at
# deploy time is that they may change on every push without touching the build.
# Do not add "referrers" to the targets: that would attest the SBOM referrer.
# Enable with --config=provenance (see .bazelrc).
signing_config(
    name = "provenance",
    args = [
        "--builder-id=https://github.com/bazel-contrib/rules_img/e2e/sbom",
        "--source-uri=https://github.com/bazel-contrib/rules_img",
        "--record-timestamps",
    ],
    # The plugin takes the image name, platform and rules_img version from the
    # request instead of from args.
    protocol = 2,
    targets = [
        "roots",
        "child_manifests",
    ],
    tool = "@rules_img_signer_provenance",
)
