load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_img//img:image.bzl", "image_from_binary")
load("@rules_img//img:multi_deploy.bzl", "multi_deploy")
load("@rules_img//img:push.bzl", "image_push")

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

image_from_binary(
    name = "image",
    base = "@distroless",
    binary = "//app",
    platforms = [
        ":linux_amd64",
        ":linux_arm64",
    ],
)

# With the SBOM toolchain registered (see MODULE.bazel), the image comes with a
# CycloneDX and an SPDX SBOM for each platform, and one for the index that refers
# to them and contains their packages. They describe the image (by digest), its
# base image and the packages of distroless's own SBOM (pulled from its cosign
# attestation), and the package metadata of what its layers are built from (//app).
filegroup(
    name = "image_sboms",
    srcs = [":image"],
    output_group = "sbom",
)

# Every SBOM lists the Debian packages of the base image, which come from the SBOM
# that distroless attests.
genrule(
    name = "sboms_contain_base_packages",
    srcs = [":image_sboms"],
    outs = ["sboms_contain_base_packages.txt"],
    cmd = """
for sbom in $(SRCS); do
  grep -q 'pkg:deb/debian/base-files@' "$$sbom" || { echo "$$sbom lacks the packages of the base image" >&2; exit 1; }
done
echo ok > $@
""",
)

# The same on a base built with `docker buildx build --sbom=true`, whose SBOMs are
# BuildKit attestations in its index: every SBOM lists the base's Alpine packages.
image_from_binary(
    name = "image_on_buildkit_base",
    base = "@buildkit_base",
    binary = "//app",
    platforms = [
        ":linux_amd64",
        ":linux_arm64",
    ],
)

filegroup(
    name = "image_on_buildkit_base_sboms",
    srcs = [":image_on_buildkit_base"],
    output_group = "sbom",
)

genrule(
    name = "sboms_contain_buildkit_base_packages",
    srcs = [":image_on_buildkit_base_sboms"],
    outs = ["sboms_contain_buildkit_base_packages.txt"],
    cmd = """
for sbom in $(SRCS); do
  grep -q 'pkg:apk/alpine/alpine-baselayout@' "$$sbom" || { echo "$$sbom lacks the packages of the BuildKit base image" >&2; exit 1; }
done
echo ok > $@
""",
)

image_push(
    name = "push_image",
    image = ":image",
    # Set the destination registry per-image here, or globally in .bazelrc via
    # --@rules_img//img/settings:destination_registry=docker.acme.tld
    # registry = "docker.acme.tld",
    repository = "malt3/supply-chain-example",
    tag = "latest",
    visibility = ["//visibility:public"],
)

# Standardized deploy entrypoints. The integration test runner runs `//:push`
# against an ephemeral local registry (destination_registry injected via
# .bazelrc.generated). `deploy` performs every operation; `push`/`load` filter.
multi_deploy(
    name = "deploy",
    operations = [":push_image"],
)

multi_deploy(
    name = "push",
    deploy_operations = ["push"],
    operations = [":push_image"],
)

multi_deploy(
    name = "load",
    deploy_operations = ["load"],
    operations = [":push_image"],
)

# Note:
#
# `image_push` pushes the SBOMs as referrers of the manifests they describe (and
# signs them along with the image when signing is enabled). You can check the
# SBOM using common tools:
# > trivy image --sbom-sources oci ghcr.io/malt3/supply-chain-example:latest
#
# You can also use standard tooling to inspect referrers:
# > regctl artifact tree ghcr.io/malt3/supply-chain-example:latest
# > oras discover ghcr.io/malt3/supply-chain-example:latest
# > regctl artifact get --subject ghcr.io/malt3/supply-chain-example:latest --filter-artifact-type application/vnd.cyclonedx+json | jq

build_test(
    name = "test",
    targets = [
        "//:image",
        "//:image_sboms",
        "//:sboms_contain_base_packages",
        "//:sboms_contain_buildkit_base_packages",
        "//:deploy",
        "//:push",
        "//:load",
        "//:push_image",
        "@rules_img_signer_cosign",
        "@rules_img_signer_notation",
    ],
)
