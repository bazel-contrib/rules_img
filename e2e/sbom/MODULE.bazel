module(name = "sbom_e2e")

# Signer plugin bazel_deps live OUTSIDE the BAZEL_DEP markers so they survive
# the substitution the integration test runner performs (it replaces everything
# between the markers with a single bazel_dep on the released rules_img). In
# released/scratch mode they resolve from the offline BCR
# (//img/private/release:bcr); in local dev mode the local_path_overrides below
# (inside the markers) build them from source instead. Versions must match
# module(version = ...) in each plugin's MODULE.bazel.
bazel_dep(name = "rules_img_signer_cosign", version = "0.0.1")
bazel_dep(name = "rules_img_signer_notation", version = "0.0.1")

# The SBOM toolchain, which attaches CycloneDX and SPDX SBOMs to every image (see
# register_toolchains below). Like the signer plugins, it resolves from the
# offline BCR in released/scratch mode (downloading its prebuilt SBOM writer), and
# from source in local dev mode.
bazel_dep(name = "rules_img_sbom", version = "0.0.1")

# BEGIN BAZEL_DEP
bazel_dep(name = "rules_img")
local_path_override(
    module_name = "rules_img",
    path = "../..",
)

bazel_dep(name = "rules_img_tool")
local_path_override(
    module_name = "rules_img_tool",
    path = "../../img_tool",
)

local_path_override(
    module_name = "rules_img_signer_cosign",
    path = "../../modules/rules_img_signer_cosign",
)

local_path_override(
    module_name = "rules_img_signer_notation",
    path = "../../modules/rules_img_signer_notation",
)

local_path_override(
    module_name = "rules_img_sbom",
    path = "../../modules/rules_img_sbom",
)

# Required when building the signer plugins and rules_img_sbom from source (local
# dev mode only: released modules are prebuilt): gazelle_override is
# root-module-only and cannot be declared in those modules themselves.
bazel_dep(name = "gazelle", version = "0.54.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/bazel-contrib/supply-chain/lib/supplychain-go",
)
go_deps.gazelle_override(
    directives = ["gazelle:go_generate_proto false"],
    path = "github.com/sigstore/rekor-tiles/v2",
)
go_deps.gazelle_override(
    directives = ["gazelle:go_generate_proto false"],
    path = "github.com/google/certificate-transparency-go",
)
go_deps.gazelle_override(
    directives = ["gazelle:go_generate_proto false"],
    path = "github.com/containerd/cgroups/v3",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["@rules_img_sbom//third_party:syft-cpe-index-embed.patch"],
    path = "github.com/anchore/syft",
)

register_toolchains("@rules_img_tool//toolchain:all")
# END BAZEL_DEP

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "platforms", version = "1.1.0")

# Attach a CycloneDX and an SPDX SBOM to every image, made from the base image's
# SBOM, the package metadata of its layers, and a scan of every layer (see
# //:sbom_toolchain).
register_toolchains("//:sbom")

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

# distroless publishes an SBOM of every image as a cosign attestation, under the
# tag sha256-<digest>.att (cosign's tag scheme, not an OCI referrer). Pulling it
# along makes the SBOMs of the images built on it contain distroless's packages.
# Its layers are downloaded too (layer_handling = "eager"), so they can be scanned.
#
# The attestations are pinned by digest, so the repository is reproducible (it
# takes part in the repository contents cache). `referrer_cosign_tags = ["att"]`
# would find them by tag instead, asking the registry on every fetch. To find the
# digests: crane digest gcr.io/distroless/static-debian13:sha256-<hex>.att
pull(
    name = "distroless",
    digest = "sha256:1a64f46364620465ef9e9a8f5413757dfdf22695e050bbfd7303eeaf17a59383",
    layer_handling = "eager",
    referrer_digests = [
        # SBOM attestation of the index (all platforms)
        "sha256:979aa44e15dd651f8be4efdf83319ea47e62914abff8f9f4397db26538c052d7",
        # SBOM attestation of the linux/amd64 manifest
        "sha256:f8945d22e9a7ba70fc282127de007a369df107f8bad8915bdebab344a3075251",
        # SBOM attestation of the linux/arm64/v8 manifest
        "sha256:5a977507aa23ab2eec49e7a25c73c6402ca5ecaf3dd01ae98618f535c7194f78",
    ],
    registry = "gcr.io",
    repository = "distroless/static-debian13",
    tag = "latest",
)

# An image built with `docker buildx build --sbom=true` (diun, which is Alpine based).
# BuildKit stores its SPDX SBOMs (and SLSA provenance) in the image index: an
# attestation manifest per platform manifest, with the platform unknown/unknown.
# `referrer_buildkit_attestations` pulls those of the selected platforms as
# referrers of their manifests, so the SBOMs of the images built on it contain the
# base's packages. They are listed by the index, which the digest pins, so the
# repository stays reproducible. Its layers are downloaded to be scanned.
pull(
    name = "buildkit_base",
    digest = "sha256:f350e8e7cc0e3b33d500e2fc462ac9273d8954327f32e2501b34b6bef5a0de3e",
    layer_handling = "eager",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    referrer_buildkit_attestations = True,
    registry = "ghcr.io",
    repository = "crazy-max/diun",
)
