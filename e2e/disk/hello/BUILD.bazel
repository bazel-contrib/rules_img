load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "hello_lib",
    srcs = ["main.go"],
    importpath = "github.com/bazel-contrib/rules_img/e2e/disk/hello",
    visibility = ["//visibility:private"],
)

# Statically linked: the service does not depend on anything in the root filesystem.
go_binary(
    name = "hello",
    embed = [":hello_lib"],
    goarch = "amd64",
    goos = "linux",
    pure = "on",
    visibility = ["//visibility:public"],
)
