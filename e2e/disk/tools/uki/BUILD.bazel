load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "uki_lib",
    srcs = [
        "main.go",
        "pe.go",
    ],
    importpath = "github.com/bazel-contrib/rules_img/e2e/disk/tools/uki",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "uki",
    embed = [":uki_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "uki_test",
    size = "small",
    srcs = ["pe_test.go"],
    embed = [":uki_lib"],
)
